<Page x:Class="Win2Pad.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Settings">

  <!-- General preferences only: screens, devices and the keyboard each have their own page. -->
  <StackPanel Margin="24,0,24,24">

    <ui:TextBlock Text="Settings" FontTypography="TitleLarge" Margin="0,0,0,4" />
    <ui:TextBlock Text="How Win2Pad starts, stays running and updates itself."
                  FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,20" />

    <ui:InfoBar x:Name="DevBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                Title="Auto-start unavailable"
                Message="Run the installed Win2Pad rather than a development build to register auto-start." />

    <ui:TextBlock Text="Startup" FontTypography="BodyStrong" Margin="0,0,0,8" />

    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start with Windows" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Launches hidden in the notification area when you sign in." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Connect automatically" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Makes this PC available to the iPad as soon as Win2Pad opens." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding StartPeripheralOnLaunch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Keep running when the window is closed" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="The iPad reconnects by itself to a Win2Pad that stays in the notification area." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:TextBlock Text="Appearance" FontTypography="BodyStrong" Margin="0,12,0,8" />

    <ui:CardControl Icon="{ui:SymbolIcon PictureInPicture24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Floating indicator" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="A small always-on-top label showing whether the input is on this PC or the iPad. Drag it anywhere; right-click to hide it." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding ShowIndicator, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:TextBlock Text="Updates" FontTypography="BodyStrong" Margin="0,12,0,8" />

    <ui:CardControl Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock x:Name="VersionText" Text="Win2Pad" FontTypography="BodyStrong" />
          <ui:TextBlock x:Name="UpdateStatus" FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <ui:Button x:Name="RestartButton" Content="Restart to update" Appearance="Primary" Margin="0,0,8,0"
                   Visibility="Collapsed" Click="OnRestartToUpdate" />
        <ui:Button x:Name="CheckButton" Content="Check now" Click="OnCheckUpdates" />
      </StackPanel>
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Update automatically" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Downloads new versions in the background and installs them the next time Win2Pad closes." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}" Margin="0,12,0,0">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Exit Win2Pad" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Closes Win2Pad completely; the iPad loses the keyboard and mouse until it starts again." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="Exit" Click="OnExit" />
    </ui:CardControl>

  </StackPanel>
</Page>
