<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Win2Pad.App</RootNamespace>
    <AssemblyName>Win2Pad</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Win2Pad</Product>
    <Company>MalvioApps</Company>
    <Copyright>Copyright (c) 2026 MalvioApps</Copyright>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>Win2Pad.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sets the exe, taskbar and Alt+Tab icon. The tray icon is deliberately not this one:
         it stays a monochrome glyph so it can follow the system theme. -->
    <ApplicationIcon>Assets\win2pad.ico</ApplicationIcon>
    <!-- WFAC010 asks for the WinForms DPI property instead, but the manifest has to declare it:
         the capture hook reports physical pixels and must not be virtualised. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win2Pad.Core\Win2Pad.Core.csproj" />
  </ItemGroup>

  <!-- App.xaml is compiled as a page so the generated Main does not compete with Program.Main. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Also a resource, so the title bar and tray can pick a size-appropriate frame at runtime. -->
  <ItemGroup>
    <Resource Include="Assets\win2pad.ico" />
  </ItemGroup>

  <!-- WinForms is here only for the tray icon; its implicit usings collide with WPF on
       Application, MessageBox, Color and Size. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
