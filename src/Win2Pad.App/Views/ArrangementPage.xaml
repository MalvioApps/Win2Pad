<Page x:Class="Win2Pad.App.Views.ArrangementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Arrangement">

  <StackPanel Margin="24,0,24,24">
    <ui:TextBlock Text="Arrangement" FontTypography="TitleLarge" Margin="0,0,0,4" />
    <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,16"
                  Text="Drag the iPad to where it sits on your desk, against any side of any screen. The pointer crosses only where they touch, and comes back at the matching point." />

    <ui:InfoBar x:Name="Hint" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12" />

    <Border x:Name="BoardFrame" Height="380" CornerRadius="8" ClipToBounds="True"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            SizeChanged="OnBoardSizeChanged">
      <Canvas x:Name="Board" />
    </Border>

    <ui:TextBlock x:Name="Summary" FontTypography="Caption" Margin="0,8,0,12" TextWrapping="Wrap"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

    <ui:CardControl x:Name="SharePanel" Icon="{ui:SymbolIcon ArrowAutofitWidth24}" Margin="0,0,0,12" Visibility="Collapsed">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Shared edge" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="How much of the screen's edge leads to the iPad, from its real size up to every screen side by side on that edge (100% per screen)." />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <Slider x:Name="ShareSlider" Width="220" VerticalAlignment="Center" SmallChange="1" LargeChange="10"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnShareChanged" />
        <ui:TextBlock x:Name="ShareValue" Width="56" Margin="12,0,0,0" VerticalAlignment="Center"
                      TextAlignment="Right" FontTypography="BodyStrong" />
      </StackPanel>
    </ui:CardControl>

    <StackPanel Orientation="Horizontal">
      <ui:Button Content="Reset" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnReset" Margin="0,0,8,0" />
      <ui:Button Content="Refresh screens" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefresh" />
    </StackPanel>
  </StackPanel>
</Page>
