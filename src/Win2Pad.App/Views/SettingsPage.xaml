<Page x:Class="Win2Pad.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Settings">

  <StackPanel Margin="24,0,24,24">

    <ui:TextBlock Text="Settings" FontTypography="TitleLarge" Margin="0,0,0,4" />
    <ui:TextBlock Text="Control how Win2Pad starts and what happens when the window is closed."
                  FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,20" />

    <ui:InfoBar x:Name="DevBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                Title="Auto-start unavailable"
                Message="Run the published executable rather than 'dotnet run' to register auto-start." />

    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start with Windows" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Launches hidden in the notification area when you sign in." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start the peripheral automatically" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Begins advertising as soon as the app launches." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding StartPeripheralOnLaunch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Keep running when the window is closed" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Paired hosts reconnect to a peripheral that never restarted, so staying resident keeps them working." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:TextBlock Text="Edge switching" FontTypography="BodyStrong" Margin="0,12,0,8" />

    <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Move to the tablet through the screen edge" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Push the pointer against the edge on the tablet's side to carry on onto it; push past the tablet's edge facing the PC to come back." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="EdgeToggle" Click="OnEdgeChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Tablet24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Tablet position" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Which side of your screens the tablet is on. Any monitor edge on that side with no other monitor beyond it leads to the tablet." />
        </StackPanel>
      </ui:CardControl.Header>
      <ComboBox x:Name="SideCombo" MinWidth="140" SelectionChanged="OnEdgeChanged">
        <ComboBoxItem Content="Right" Tag="Right" />
        <ComboBoxItem Content="Left" Tag="Left" />
        <ComboBoxItem Content="Above" Tag="Top" />
        <ComboBoxItem Content="Below" Tag="Bottom" />
      </ComboBox>
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Ruler24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock x:Name="DeviceTitle" Text="No tablet connected" FontTypography="BodyStrong" />
          <ui:TextBlock x:Name="DeviceDetail" FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Connect the iPad over Bluetooth: Win2Pad reads its model and calibrates itself." />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="OrientationCombo" MinWidth="130" Margin="0,0,8,0" SelectionChanged="OnOrientationChanged">
          <ComboBoxItem Content="Landscape" Tag="landscape" />
          <ComboBoxItem Content="Portrait" Tag="portrait" />
        </ComboBox>
        <ui:Button Content="Fine-tune with Safari…" Click="OnFineTune" />
      </StackPanel>
    </ui:CardControl>

    <ui:TextBlock Text="Other" FontTypography="BodyStrong" Margin="0,12,0,8" />

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Shake the pointer to switch target" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Move the mouse rapidly back and forth to cycle between this PC and the paired hosts. Ctrl+Alt+CapsLock always works too." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="SwitchGestureToggle" Click="OnSwitchGestureChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Exit Win2Pad" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Stops advertising and removes the tray icon. Hosts will need to reconnect." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="Exit" Click="OnExit" />
    </ui:CardControl>

  </StackPanel>
</Page>
