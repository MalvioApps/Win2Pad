<Page x:Class="Win2Pad.App.Views.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:Win2Pad.App.Converters"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Keyboard and mouse">

  <Page.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <StackPanel Margin="24,0,24,24">

      <ui:TextBlock Text="Keyboard and mouse" FontTypography="TitleLarge" Margin="0,0,0,4" />
      <ui:TextBlock Text="Send this PC's keyboard and mouse to the iPad by hand, and the shortcuts that switch between them."
                    FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" Margin="0,0,0,20" />

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Capture takes over this PC"
                  Message="While input is going to the iPad, this window stops receiving it. Press Ctrl+Alt+Q to come back to this PC, or Ctrl+Alt+CapsLock to switch to the next target."
                  IsOpen="{Binding IsRedirecting}" />

      <ui:InfoBar x:Name="NoHostsBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="No iPad connected yet"
                  Message="Pair the iPad from its Settings → Bluetooth (tap this PC under Other Devices) and wait a few seconds for it to connect." />

      <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,16">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Capture keyboard and mouse" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Target, StringFormat='Sending to: {0}'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="CaptureToggle"
                         IsChecked="{Binding IsCapturing, Mode=OneWay}"
                         IsEnabled="{Binding CanCapture}"
                         Click="OnToggleCapture" />
      </ui:CardControl>

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Lock keys on the target host"
                  Message="{Binding TargetLockWarning, Mode=OneWay}"
                  IsOpen="{Binding HasTargetLockWarning, Mode=OneWay}" />

      <ui:TextBlock Text="Send input to" FontTypography="Subtitle" Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Targets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardControl Margin="0,0,0,8">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" />
                  <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </ui:CardControl.Header>
              <RadioButton GroupName="InputTarget"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           Checked="OnTargetChecked" />
            </ui:CardControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:TextBlock Text="Pointer" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Minimum pointer interval" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding LinkIntervalMs, StringFormat='Paced to {0} ms right now — whichever is slower of this minimum and the connection interval the host negotiated.'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Slider Width="160" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding PointerIntervalMs, Mode=TwoWay}" />
          <ui:TextBlock Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                        Text="{Binding PointerIntervalMs, StringFormat='{}{0} ms'}" />
        </StackPanel>
      </ui:CardControl>

      <ui:TextBlock Text="Keyboard layout" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:InfoBar Severity="Informational" IsClosable="False" IsOpen="True" Margin="0,0,0,8"
                  Title="Set your keyboard's layout on the iPad"
                  Message="Win2Pad sends keys by position, like any Bluetooth keyboard, and the iPad decides which character each one types. On the iPad, choose the same layout as your keyboard in Settings → General → Keyboard → Hardware Keyboard." />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Swap the two ISO keys" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Only if the key left of 1 and the key left of Z come out swapped on the iPad (for example º and &lt; on a Spanish keyboard)." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="SwapIsoToggle" Click="OnSwapIsoChanged" />
      </ui:CardControl>

      <ui:TextBlock Text="Shortcuts" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Switch to the next target" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <StackPanel MaxWidth="240">
          <ui:TextBlock Text="Ctrl + Alt + CapsLock" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" />
          <ui:TextBlock Text="or Ctrl + D + C" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Back to this PC" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Always works, whatever the iPad is doing." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:TextBlock Text="Ctrl + Alt + Q" FontFamily="Cascadia Mono, Consolas"
                      FontTypography="Body" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Cursor24}">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Shake the pointer to switch" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Move the mouse rapidly back and forth to go to the next target, like Ctrl+Alt+CapsLock." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="SwitchGestureToggle" Click="OnSwitchGestureChanged" />
      </ui:CardControl>

  </StackPanel>
</Page>
